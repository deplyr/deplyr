# Copy to apps/worker/.env for local development — Bun loads it automatically.
DATABASE_URL=postgres://argo:argo@localhost:5432/argo
REDIS_URL=redis://localhost:6379

# Must match apps/api/.env's ARGO_MASTER_KEY — both read/write the same
# encrypted columns.
ARGO_MASTER_KEY=

# Public WebSocket URL the *managed* server's agent will dial back to —
# not localhost unless you're testing against a VM that can reach your
# machine. In production this is wss://<your control plane host>/agent/ws.
ARGO_CONTROL_PLANE_WS=ws://localhost:4000/agent/ws

# What deployed apps' subdomains are built from, e.g. "my-app.argo.app".
# Must match apps/web's NEXT_PUBLIC_APP_DOMAIN (it's cosmetic there; here
# it's what actually goes into the nginx config the agent writes).
ARGO_APP_DOMAIN=argo.app

# Optional. A wildcard TLS cert/key (PEM, full chain) for ARGO_APP_DOMAIN —
# only obtainable if you actually control that domain's DNS. Without
# these, deployed apps are reachable over HTTP only; see
# docs/PHASE1_DESIGN.md section 5.3.
ARGO_WILDCARD_CERT_PEM=
ARGO_WILDCARD_KEY_PEM=
