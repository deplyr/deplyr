# Copy to apps/worker/.env for local development — Bun loads it automatically.
DATABASE_URL=postgres://argo:argo@localhost:5432/argo
REDIS_URL=redis://localhost:6379

# Must match apps/api/.env's DEPLYR_MASTER_KEY — both read/write the same
# encrypted columns.
DEPLYR_MASTER_KEY=

# Public WebSocket URL the *managed* server's agent will dial back to —
# not localhost unless you're testing against a VM that can reach your
# machine. In production this is wss://<your control plane host>/agent/ws.
DEPLYR_CONTROL_PLANE_WS=ws://localhost:4000/agent/ws

# What deployed apps' subdomains are built from, e.g. "my-app.deplyr.app".
# Must match apps/web's NEXT_PUBLIC_APP_DOMAIN (it's cosmetic there; here
# it's what actually goes into the nginx config the agent writes).
DEPLYR_APP_DOMAIN=deplyr.app

# Optional. A wildcard TLS cert/key (PEM, full chain) for DEPLYR_APP_DOMAIN —
# only obtainable if you actually control that domain's DNS. Without
# these, deployed apps are reachable over HTTP only; see
# docs/architecture.md
DEPLYR_WILDCARD_CERT_PEM=
DEPLYR_WILDCARD_KEY_PEM=

# Optional. Base URL of the web app, used to add "Open in Deplyr" links to Slack/Discord
# notifications (same value as apps/api/.env). Without it, messages simply have no link.
WEB_URL=http://localhost:3000
