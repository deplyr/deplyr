# Copy to apps/web/.env.local for local development — Next.js loads it
# automatically.

# Used by Server Components/middleware running inside the Next.js server
# process (not the browser).
API_URL=http://localhost:4000

# Used by the browser directly (form submits, status polling, the GitHub
# login link) — must be reachable from wherever the browser runs.
NEXT_PUBLIC_API_URL=http://localhost:4000
