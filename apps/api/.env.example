# Copy to apps/api/.env for local development — Bun loads it automatically.
DATABASE_URL=postgres://argo:argo@localhost:5432/argo
REDIS_URL=redis://localhost:6379
PORT=4000

# openssl rand -base64 32
ARGO_MASTER_KEY=
# openssl rand -base64 32
ARGO_SESSION_SECRET=

# GitHub OAuth App — see README "Self-hosting the control plane" for how
# to create one. Callback URL must exactly match GITHUB_OAUTH_REDIRECT_URI.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://localhost:4000/auth/github/callback

# Where the API redirects the browser back to after login.
WEB_URL=http://localhost:3000
