# Copy to scripts/e2e-test.env and fill in. Used by scripts/e2e-smoke-test.sh.

# A server already registered in Deplyr (Servers tab -> its URL has the id),
# dedicated to smoke testing — the script deploys real projects to it.
TEST_SERVER_ID=

# SSH private key for that same server (whatever you registered it with).
# Only needed to rebuild+swap the agent container (skip with --skip-agent-build
# if you just want to redeploy the test projects against whatever agent is
# already running).
TEST_SERVER_SSH_KEY=~/.ssh/id_ed25519

# Email of the Deplyr account that owns that server — the script mints
# itself a session for this user directly (via DEPLYR_SESSION_SECRET, read
# from apps/api/.env), so no password or browser cookie needed.
TEST_USER_EMAIL=you@example.com

# GitHub repos to deploy as the test projects (owner/repo). Point these at
# apps/agent's own test fixtures, or your own throwaway repos — anything
# with a real package.json and a health route works. Defaults match the
# minimal repos this was first run against.
TEST_BACKEND_REPO=abhilaksh-arora/deplyr-test-backend
TEST_BACKEND_BRANCH=master
TEST_FRONTEND_REPO=abhilaksh-arora/deplyr-test-frontend
TEST_FRONTEND_BRANCH=master

# Where the local API is reachable from this machine.
DEPLYR_API_URL=http://localhost:4000
