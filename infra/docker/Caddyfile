# Terminates TLS for the control plane itself (not to be confused with the
# per-app nginx the agent manages on a *managed* server — see
# infra/agent-install.sh). Automatic Let's Encrypt cert + renewal, keyed off
# DEPLYR_SITE_ADDRESS from .env — the bare domain for a real domain, but
# `http://<ip>` for a bare IP: Caddy otherwise turns on auto-HTTPS for an IP too
# (self-signed cert + an HTTP->HTTPS redirect), which lands on a port that's
# usually closed. DEPLYR_PUBLIC_HOST is the same host without the scheme. Two site blocks, same hostname: the browser
# reaches web on the default port and api on :4000, matching
# NEXT_PUBLIC_API_URL's shape (see docker-compose.prod.yml) — Caddy issues
# one cert and reuses it for both, since certs are per-hostname, not per-port.
#
# This is only ever the *bootstrap* config. Adding a custom domain from
# Settings in the dashboard pushes a new one of these straight to Caddy's
# admin API at runtime (apps/api/src/routes/instance.ts) — no file edit, no
# restart. --resume on the caddy service (see docker-compose.prod.yml) is
# what makes that survive a restart instead of resetting to this file.

# Admin API on the Docker network (not the host — compose doesn't publish
# 2019) so the api container can push config from Settings. By default it only
# listens on localhost, unreachable from other containers, and rejects any Host
# header it doesn't list. apps/api/src/routes/instance.ts sends this same
# block with every config it pushes — a pushed Caddyfile replaces this whole
# file, so leaving it out there would lock the api out after the first push.
{
	admin 0.0.0.0:2019 {
		origins caddy:2019 localhost:2019 127.0.0.1:2019
	}
}

{$DEPLYR_SITE_ADDRESS} {
	# The browser calls the API at /api on whatever origin it loaded the page
	# from (http://<ip> or https://<domain>), so nothing about the API's address
	# is baked into the web build — see NEXT_PUBLIC_API_URL in the compose file.
	handle_path /api/* {
		reverse_proxy api:4000 {
			stream_close_delay 5m
		}
	}
	handle {
		reverse_proxy web:3000
	}
}

{$DEPLYR_SITE_ADDRESS}:4000 {
	reverse_proxy api:4000 {
			stream_close_delay 5m
		}
}

# stream_close_delay: Caddy closes proxied WebSockets (the agent's) when its config
# reloads, and every deploy reloads it — keep them open.

# The agent on this box (host network) reaches the api through the port Caddy
# publishes, on the loopback address — no public IP or firewall rule involved.
http://127.0.0.1 {
	handle_path /api/* {
		reverse_proxy api:4000 {
			stream_close_delay 5m
		}
	}
}
